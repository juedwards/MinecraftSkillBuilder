# Azure AI Foundry. Any of these endpoint forms work:
#   https://<resource>.openai.azure.com/
#   https://<resource>.services.ai.azure.com/
#   https://<resource>.services.ai.azure.com/api/projects/<project>
AZURE_AI_ENDPOINT=https://your-resource.services.ai.azure.com/
AZURE_AI_API_KEY=
# The *deployment* name of your model in Foundry
AZURE_AI_MODEL=gpt-4o-mini

# WebSocket server that Minecraft connects to
MC_HOST=0.0.0.0
MC_PORT=3000

# Only answer chat starting with this prefix (e.g. "!ai"). Empty = answer everything.
MC_TRIGGER=
# true = reply only to the player who asked; false = reply to everyone
MC_REPLY_PRIVATE=false
# Number of past messages remembered per player
MAX_HISTORY=20
# Optional: override the default system prompt
# SYSTEM_PROMPT=

# Minecraft Skill Builder web interface. Keep it on 127.0.0.1: the Settings page can change credentials.
WEB_HOST=127.0.0.1
WEB_PORT=8080
